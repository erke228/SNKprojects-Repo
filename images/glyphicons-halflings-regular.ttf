<form action="/Account/SocialLogin" id="social_login_form" method="post"><input name="__RequestVerificationToken" type="hidden" value="_7hrJdl8Hir2dyS5TLkyFFhSJXGpop-DgLaKRpyJ9ZMQo1Hm_OHfP_pyjV5bHBFYZWDAtarpZscBTugp1abGEFW0iJo1" />    <input type="hidden" name="Token" id="login_social_token_input" />
